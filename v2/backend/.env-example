# Token de acesso pessoal do Vimeo. Obrigatório — sem ele o servidor não sobe.
VIMEO_TOKEN=

# ID da vitrine (showcase) "narrative" no Vimeo. Opcional: sem ID, essa
# vitrine retorna [] sem chamar a API do Vimeo.
VIMEO_ALBUM_NARRATIVE=

# ID da vitrine (showcase) "commercial" no Vimeo. Opcional, mesmo
# comportamento acima.
VIMEO_ALBUM_COMMERCIAL=

# Porta em que o servidor Express sobe. Opcional, padrão 3000.
PORT=

# Validade do cache em memória dos vídeos, em minutos. Opcional, padrão 15.
CACHE_TTL_MINUTES=

# Origens permitidas por CORS nas rotas /api, separadas por vírgula
# (ex: https://theonogueira.com,https://www.theonogueira.com).
# Opcional: sem valor, CORS fica desativado (uso recomendado quando o
# front e o backend são servidos pelo mesmo domínio/origem).
ALLOWED_ORIGINS=
